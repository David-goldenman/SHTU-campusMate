"""Frozen-compatible PROJECT root resolver.

打包后 backend/core/paths.py 会被这个文件覆盖。它决定 `modules/`, `web/`,
`scripts/`, `.private/` 在哪个真实目录下。

约定（最终安装目录）：

    C:\Program Files\Campus Framework\
        CampusFramework.exe         ← sys.executable 在这
        bin/node/node.exe           ← portable Node
        modules/                    ← 模块
        web/                        ← 前端
        scripts/                    ← dpapi.ps1 / browser.mjs
        .private/                   ← 首次运行时创建（DPAPI + 用户数据）
        _internal/                  ← PyInstaller 运行时（用户不需感知）
"""
import sys
from pathlib import Path

if getattr(sys, 'frozen', False):
    # PyInstaller frozen: use the directory containing the .exe as PROJECT
    PROJECT = Path(sys.executable).resolve().parent
else:
    PROJECT = Path(__file__).resolve().parents[2]

DATA = PROJECT / ".private"
RUNTIME = DATA / "runtime"
WEB = PROJECT / "web"
MODULES = PROJECT / "modules"
SCRIPTS = PROJECT / "scripts"          # 新增：vault/browser 都要用
DATA.mkdir(parents=True, exist_ok=True)
